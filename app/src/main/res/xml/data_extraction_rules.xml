<?xml version="1.0" encoding="utf-8"?>
<!--
  Auto Backup + device-transfer allowlist (API 31+). Names the data domains explicitly so the run
  database is included on both cloud backup and phone-to-phone transfer; `domain="root"` alone omits
  the database/sharedpref/file sub-domains, which left run history unprotected. See backup_rules.xml.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <include domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <include domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
